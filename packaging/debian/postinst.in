#!/bin/sh
# SPDX-FileCopyrightText: 2026 Arthur Melikbekyan
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Sets up the virtual camera through the hook every package shares; the hook
# never fails, and neither does this, should the hook be missing.

set -e

if [ "$1" = "configure" ]; then
    "@WBC_INSTALL_HOOK@" || true
fi

exit 0
